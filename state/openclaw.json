{
  "identity": {
    "name": "Bot"
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/anthropic/claude-sonnet-4-5"
      }
    }
  },
  "channels": {
    "discord": {
      "enabled": true,
      "dmPolicy": "pairing",
      "dm": {
        "enabled": true
      },
      "guilds": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "logging": {
    "level": "info",
    "consoleStyle": "pretty"
  }
}
