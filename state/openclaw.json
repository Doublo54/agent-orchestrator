{
  "gateway": {
    "mode": "local",
    "auth": {
      "enabled": true
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/anthropic/claude-sonnet-4-5"
      }
    },
    "list": [
      {
        "id": "main",
        "identity": {
          "name": "Bot"
        }
      }
    ]
  },
  "channels": {
    "discord": {
      "enabled": true,
      "dm": {
        "enabled": true,
        "policy": "pairing"
      },
      "guilds": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "logging": {
    "level": "info",
    "consoleStyle": "pretty"
  }
}
