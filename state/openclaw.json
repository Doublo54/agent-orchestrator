{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "sandbox": {
        "mode": "non-main",
        "scope": "agent",
        "workspaceAccess": "rw"
      }
    },
    "list": [
      {
        "id": "main",
        "identity": {
          "name": "Claw",
          "emoji": "🦞"
        },
        "groupChat": {
          "mentionPatterns": ["@Claw", "🦞"]
        }
      }
    ]
  },
  "channels": {
    "discord": {
      "enabled": true,
      "dm": {
        "enabled": true,
        "policy": "pairing"
      },
      "guilds": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "logging": {
    "level": "info",
    "consoleStyle": "pretty"
  }
}