# ============================================================
# Discord Bot — Environment Variables
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Docs: https://docs.openclaw.ai/channels/discord
# NEVER commit .env to version control.
# ============================================================

# --- LLM Provider (required) ---
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Discord Bot (required) ---
# Create at https://discord.com/developers/applications
# Enable intents: Message Content + Server Members
# Bot permissions: View Channels, Send Messages, Read Message History,
#                  Embed Links, Attach Files, Add Reactions
DISCORD_BOT_TOKEN=

# --- OpenClaw Gateway ---
# Auth token for the Control UI (optional).
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Exposed port on host (default: 18789)
OPENCLAW_PORT=18789

# Timezone
TZ=UTC
